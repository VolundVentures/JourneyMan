generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// AUTH (NextAuth.js compatible)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// CORE ENTITIES
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter") // starter | professional | enterprise
  settings  String   @default("{}") // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  employees Employee[]
  tasks     Task[]
  approvals Approval[]
  escalations Escalation[]
  knowledgeItems KnowledgeItem[]
  integrations Integration[]
  auditLogs AuditLog[]
  contacts  Contact[]
  companies Company[]
}

model User {
  id        String   @id @default(cuid())
  orgId     String?
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("member") // admin | manager | member
  avatarUrl String?
  settings  String   @default("{}") // JSON
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id])
  accounts     Account[]
  sessions     Session[]
}

model Employee {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  roleTitle      String
  roleTemplateId String?
  department     String
  reportsTo      String?
  reportsToName  String?
  status         String   @default("onboarding") // onboarding | supervised | active | paused | terminated

  // Identity
  emailAddress String?
  phoneNumber  String?
  slackUserId  String?

  // Configuration (JSON)
  config String @default("{}") // EmployeeConfig JSON

  // Performance
  autonomyScore   Float @default(0)
  tasksCompleted  Int   @default(0)
  escalationRate  Float @default(0)

  // Timestamps
  hiredAt     DateTime @default(now())
  onboardedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  tasks        Task[]
  approvals    Approval[]
  escalations  Escalation[]
  messages     Message[]
  handoffsFrom Handoff[] @relation("HandoffFrom")
  handoffsTo   Handoff[] @relation("HandoffTo")
}

// ============================================
// TASKS & WORKFLOW
// ============================================

model Task {
  id             String   @id @default(cuid())
  orgId          String
  employeeId     String
  title          String
  description    String?
  source         String   @default("human_assigned") // human_assigned | event_triggered | scheduled | proactive | employee_handoff
  status         String   @default("queued") // queued | planning | in_progress | awaiting_approval | awaiting_input | escalated | completed | failed
  priority       Int      @default(50) // 0-100
  confidenceScore Float?
  plan           String?  // JSON
  result         String?  // JSON
  assignedBy     String?
  assignedByName String?
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  approvals    Approval[]
  escalations  Escalation[]
  messages     Message[]
  handoffs     Handoff[]
}

model Approval {
  id              String   @id @default(cuid())
  orgId           String
  employeeId      String
  employeeName    String?
  employeeRole    String?
  taskId          String?
  actionType      String
  proposedAction  String   @default("{}") // JSON
  reasoning       String
  confidenceScore Float
  context         String?  // JSON
  status          String   @default("pending") // pending | approved | modified | rejected
  resolvedBy      String?
  resolutionFeedback String?
  resolvedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])
}

model Escalation {
  id             String   @id @default(cuid())
  orgId          String
  employeeId     String
  employeeName   String?
  employeeRole   String?
  taskId         String?
  reason         String
  context        String   @default("{}") // JSON
  recommendation String?
  urgency        String   @default("medium") // low | medium | high | critical
  status         String   @default("open") // open | resolved | dismissed
  resolvedBy     String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])
}

// ============================================
// COMMUNICATION
// ============================================

model Message {
  id          String   @id @default(cuid())
  orgId       String
  employeeId  String
  channel     String   // email | slack | teams | phone | internal
  direction   String   // inbound | outbound
  threadId    String?
  fromAddress String?
  toAddress   String?
  subject     String?
  body        String
  metadata    String   @default("{}") // JSON
  taskId      String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])
}

// ============================================
// KNOWLEDGE BASE
// ============================================

model KnowledgeItem {
  id          String   @id @default(cuid())
  orgId       String
  sourceType  String   // upload | sync | manual
  sourceRef   String?
  title       String
  content     String
  contentHash String
  chunkIndex  Int      @default(0)
  metadata    String   @default("{}") // JSON
  status      String   @default("active") // active | deprecated | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
}

// ============================================
// INTEGRATIONS
// ============================================

model Integration {
  id           String   @id @default(cuid())
  orgId        String
  employeeId   String?
  provider     String
  scopes       String   @default("[]") // JSON array
  status       String   @default("active") // active | expired | revoked
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
}

// ============================================
// HANDOFFS
// ============================================

model Handoff {
  id               String   @id @default(cuid())
  orgId            String
  taskId           String
  fromEmployeeId   String
  fromEmployeeName String
  toEmployeeId     String
  toEmployeeName   String
  reason           String
  contextPackage   String   @default("{}") // JSON
  status           String   @default("pending") // pending | accepted | rejected | completed
  approvedBy       String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  task         Task     @relation(fields: [taskId], references: [id])
  fromEmployee Employee @relation("HandoffFrom", fields: [fromEmployeeId], references: [id])
  toEmployee   Employee @relation("HandoffTo", fields: [toEmployeeId], references: [id])
}

// ============================================
// CONTACTS & CRM
// ============================================

model Contact {
  id                 String   @id @default(cuid())
  orgId              String
  name               String
  email              String?
  phone              String?
  company            String?
  companyId          String?
  title              String?
  labels             String   @default("[]") // JSON array
  interactionCount   Int      @default(0)
  lastInteractionAt  DateTime?
  sentimentScore     Float?
  assignedEmployeeIds String  @default("[]") // JSON array
  metadata           String   @default("{}") // JSON
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
}

model Company {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  domain     String?
  industry   String?
  size       String?
  contactIds String   @default("[]") // JSON array
  dealValue  Float?
  stage      String?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id            String   @id @default(cuid())
  orgId         String
  actorType     String   // human | ai_employee | system
  actorId       String
  actorName     String
  action        String
  resourceType  String
  resourceId    String
  resourceName  String?
  details       String   @default("{}") // JSON
  previousState String?  // JSON
  newState      String?  // JSON
  ipAddress     String?
  severity      String   @default("info") // info | warning | critical
  timestamp     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
}
